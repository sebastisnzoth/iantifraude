{
  "name": "antigolpe-assistant",
  "main": "index.mjs",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "AssistantQuota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AssistantQuota"] }],
  "ratelimits": [{ "name": "BURST", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }]
}
